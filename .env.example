# Copy to .env and replace every value. The .env file is never committed.

# Generate each secret with: openssl rand -base64 36
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-at-least-32-characters-long

# The first admin account. Change this password after the first login.
SEED_ADMIN_EMAIL=admin@formulaweek.local
SEED_ADMIN_PASSWORD=change-me-too

# Local defaults. For production, set the real domain and your email for certificates.
SITE_ADDRESS=localhost
CADDY_TLS=internal
APP_URL=https://localhost
COOKIE_SECURE=true

# Mailpit catches email locally at http://localhost:8025. Use a real SMTP account in production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Formula Week <no-reply@formulaweek.local>
