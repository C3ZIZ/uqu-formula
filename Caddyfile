# HTTPS, compression, security headers, and load balancing across the web replicas.
{$SITE_ADDRESS:localhost} {
	tls {$CADDY_TLS:internal}
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	@textures path /textures/*
	header @textures >Cache-Control "public, max-age=604800"

	reverse_proxy {
		dynamic a {
			name web
			port 3000
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 10s
	}
}
